{
  "name": "reflex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal assistant you text: it has its own computer, your accounts, and a memory. Built on Fountain.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "server": "bun --watch server/index.ts",
    "messages:relay": "bun run relay/messages-mac.ts",
    "signal:relay": "bun run relay/signal.ts"
  },
  "dependencies": {
    "@agentshit/fountain-sdk": "^1.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
